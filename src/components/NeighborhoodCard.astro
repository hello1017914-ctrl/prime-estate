---
import type { Neighborhood } from "../data/neighborhoods";

interface Props {
  neighborhood: Neighborhood;
}

const { neighborhood } = Astro.props;
---

<article
  class="group overflow-hidden rounded-3xl bg-white shadow-card transition duration-300 hover:-translate-y-0.5 hover:shadow-soft"
>
  <a
    href={`/neighborhoods/${neighborhood.slug}`}
    class="block focus-visible:outline-offset-4"
  >
    <div class="relative aspect-[5/4] overflow-hidden">
      <img
        src={neighborhood.image}
        alt={`Homes in ${neighborhood.name}`}
        class="img-zoom h-full w-full object-cover"
        loading="lazy"
        width="800"
        height="640"
      />
    </div>
    <div class="p-5">
      <div class="flex items-center justify-between gap-3">
        <h3 class="text-lg font-bold tracking-tight text-ink">
          {neighborhood.name}
        </h3>
        <span class="rounded-full bg-lime-soft px-2.5 py-1 text-xs font-semibold text-forest">
          {neighborhood.priceRange}
        </span>
      </div>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        {neighborhood.summary}
      </p>
    </div>
  </a>
</article>
