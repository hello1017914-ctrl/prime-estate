---
import type { Property } from "../data/properties";
import { formatPrice } from "../data/properties";

interface Props {
  property: Property;
}

const { property } = Astro.props;
---

<article
  class="group overflow-hidden rounded-3xl bg-white shadow-card transition duration-300 hover:-translate-y-0.5 hover:shadow-soft"
>
  <a href={`/buy/${property.slug}`} class="block focus-visible:outline-offset-4">
    <div class="relative aspect-[4/3] overflow-hidden">
      <img
        src={property.image}
        alt={`Exterior view related to ${property.address}`}
        class="img-zoom h-full w-full object-cover"
        loading="lazy"
        width="800"
        height="600"
      />
      <span
        class="absolute left-4 top-4 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-ink shadow-sm"
      >
        {property.status === "Sample" ? "Sample" : "For Sale"}
      </span>
    </div>
    <div class="p-5">
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-base font-bold tracking-tight text-ink">
          {property.address}
        </h3>
        <p class="shrink-0 text-base font-bold text-forest">
          {formatPrice(property.price)}
        </p>
      </div>
      <p class="mt-1 text-sm text-muted">
        {property.neighborhood} · {property.city}, {property.state} {property.zip}
      </p>
      <dl class="mt-4 flex flex-wrap gap-3 text-sm text-muted">
        <div class="inline-flex items-center gap-1.5 rounded-full bg-mist px-3 py-1">
          <dt class="sr-only">Bedrooms</dt>
          <dd>{property.beds} beds</dd>
        </div>
        <div class="inline-flex items-center gap-1.5 rounded-full bg-mist px-3 py-1">
          <dt class="sr-only">Bathrooms</dt>
          <dd>{property.baths} baths</dd>
        </div>
        <div class="inline-flex items-center gap-1.5 rounded-full bg-mist px-3 py-1">
          <dt class="sr-only">Square feet</dt>
          <dd>{property.sqft.toLocaleString()} sq ft</dd>
        </div>
      </dl>
    </div>
  </a>
</article>
