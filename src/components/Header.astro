---
import { site, navLinks } from "../data/site";
const pathname = Astro.url.pathname;
---

<header class="absolute inset-x-0 top-0 z-50">
  <div class="container-site pt-4 sm:pt-5">
    <div
      class="glass flex h-14 items-center justify-between gap-3 rounded-full border border-white/50 px-3 shadow-soft sm:h-16 sm:px-4"
    >
      <a href="/" class="flex shrink-0 items-center gap-2 pl-2">
        <span
          class="flex h-8 w-8 items-center justify-center rounded-full bg-forest text-xs font-bold text-lime"
          aria-hidden="true"
        >
          MW
        </span>
        <span class="text-sm font-bold tracking-tight text-ink sm:text-base">
          {site.name}
        </span>
      </a>

      <nav
        class="hidden items-center gap-1 rounded-full bg-mist/80 p-1 lg:flex"
        aria-label="Primary"
      >
        {
          [{ href: "/", label: "Home" }, ...navLinks].map((link) => {
            const active =
              link.href === "/"
                ? pathname === "/"
                : pathname === link.href || pathname.startsWith(link.href + "/");
            return (
              <a
                href={link.href}
                class:list={[
                  "rounded-full px-3.5 py-2 text-sm font-medium transition",
                  active
                    ? "bg-white text-ink shadow-sm"
                    : "text-muted hover:text-ink",
                ]}
                aria-current={active ? "page" : undefined}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <div class="flex items-center gap-2">
        <a
          href="/contact"
          class="hidden rounded-full bg-lime px-4 py-2.5 text-sm font-semibold text-ink transition hover:bg-lime-deep sm:inline-flex"
        >
          Let’s Connect
        </a>
        <button
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-line bg-white text-ink lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-menu-toggle
        >
          <span class="sr-only">Open menu</span>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M5 8h14M5 12h14M5 16h14"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-nav"
    class="container-site mt-2 hidden lg:hidden"
    data-mobile-nav
  >
    <nav
      class="glass flex flex-col gap-1 rounded-3xl border border-white/50 p-3 shadow-soft"
      aria-label="Mobile"
    >
      {
        [{ href: "/", label: "Home" }, ...navLinks].map((link) => (
          <a
            href={link.href}
            class="rounded-2xl px-4 py-3 text-base font-medium text-ink hover:bg-mist"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/contact"
        class="mt-1 rounded-full bg-lime px-4 py-3 text-center text-sm font-semibold text-ink"
      >
        Let’s Connect
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const panel = document.querySelector("[data-mobile-nav]");
  toggle?.addEventListener("click", () => {
    const open = panel?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
