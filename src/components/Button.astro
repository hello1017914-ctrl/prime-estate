---
interface Props {
  href?: string;
  variant?: "primary" | "dark" | "secondary" | "ghost" | "light";
  type?: "button" | "submit" | "reset";
  class?: string;
}

const {
  href,
  variant = "primary",
  type = "button",
  class: className = "",
} = Astro.props;

const variants: Record<string, string> = {
  primary:
    "bg-lime text-ink hover:bg-lime-deep shadow-sm",
  dark: "bg-ink text-white hover:bg-ink-soft",
  secondary:
    "bg-white text-ink border border-line hover:border-ink/20 hover:bg-snow",
  ghost: "bg-transparent text-ink hover:text-forest px-0",
  light: "bg-white/95 text-ink hover:bg-white shadow-sm",
};

const classes = `inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-semibold tracking-tight transition duration-300 ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
