---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { testimonials } from "../data/testimonials";
---

<BaseLayout
  title="Client Stories"
  description="Hear from clients who bought and sold with Mary Wassef: the Boyd family, Bailey/Olstad family, Caroline Bower Lawrence, Elbert Johnson, Johnny Hollins, and Jacquelyn Talbert."
>
  <section class="relative overflow-hidden bg-forest-deep pb-16 pt-32 text-white">
    <img
      src="/images/stories/hero.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-top opacity-35"
      width="720"
      height="1080"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-forest-deep via-forest-deep/85 to-forest-deep/55"></div>
    <div class="container-site relative max-w-3xl">
      <p class="text-sm font-semibold text-lime">Client stories</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl text-balance">
        Hear the stories of Mary’s clients
      </h1>
      <p class="mt-4 max-w-2xl text-white/80 leading-relaxed">
        Hard work, dedication, friendship, and expertise. Mary has maintained a
        five-star Google rating for over a decade.
      </p>
    </div>
  </section>

  <section class="bg-snow py-16 sm:py-20">
    <div class="container-site space-y-16">
      {
        testimonials.map((story, index) => (
          <article
            id={story.slug}
            class:list={[
              "grid items-center gap-8 lg:gap-12",
              index % 2 === 1 ? "lg:grid-cols-[1.05fr_0.95fr]" : "lg:grid-cols-[0.95fr_1.05fr]",
            ]}
          >
            <div
              class:list={[
                "overflow-hidden rounded-3xl bg-mist shadow-card",
                index % 2 === 1 ? "lg:order-2" : "",
              ]}
            >
              <img
                src={story.image}
                alt={story.attribution}
                class="aspect-[5/4] w-full object-cover"
                width="900"
                height="720"
                loading={index === 0 ? "eager" : "lazy"}
              />
            </div>
            <div class:list={[index % 2 === 1 ? "lg:order-1" : ""]}>
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-forest">
                {story.title}
              </p>
              <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink">
                {story.attribution}
              </h2>
              {story.role ? (
                <p class="mt-1 text-sm text-muted">{story.role}</p>
              ) : null}
              <p class="mt-5 text-lg font-semibold leading-snug text-ink text-balance">
                “{story.quote}”
              </p>
              <div class="mt-5 space-y-4 text-muted leading-relaxed">
                {story.body.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="container-site mt-16 text-center">
      <div class="rounded-3xl bg-white px-6 py-12 shadow-card sm:px-10">
        <h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          Ready to join them?
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-muted">
          Contact Mary today to talk about buying or selling in the Heights.
        </p>
        <div class="mt-6">
          <Button href="/contact" variant="dark">Contact Mary</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
