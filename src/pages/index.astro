---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import PropertyCard from "../components/PropertyCard.astro";
import NeighborhoodCard from "../components/NeighborhoodCard.astro";
import { site } from "../data/site";
import { properties } from "../data/properties";
import { neighborhoods } from "../data/neighborhoods";
import { testimonials } from "../data/testimonials";

const featured = properties.slice(0, 3);
const featuredNeighborhoods = neighborhoods.slice(0, 4);
const featuredStory = testimonials[1]; // Bailey/Olstad featured quote from live site
---

<BaseLayout>
  <section class="relative overflow-hidden bg-forest-deep pb-12 pt-28 text-white sm:pb-16 sm:pt-32">
    <img
      src="/images/hero-home.jpg"
      alt="Houston Heights home exterior"
      class="hero-media absolute inset-0 h-full w-full object-cover"
      width="2000"
      height="1333"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-forest-deep/75 via-forest-deep/45 to-forest-deep/80"></div>

    <div class="container-site relative">
      <div class="max-w-3xl">
        <p class="fade-up text-sm font-semibold text-lime">
          {site.name} · {site.tagline}
        </p>
        <h1
          class="fade-up fade-up-delay-1 mt-4 text-4xl font-bold leading-[1.08] tracking-tight text-balance sm:text-5xl md:text-6xl"
        >
          Houston Heights real estate, handled with care.
        </h1>
        <p
          class="fade-up fade-up-delay-2 mt-5 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg"
        >
          {site.yearsInRealEstate}+ years helping buyers and sellers across the
          Heights and near-town neighborhoods, with marketing that gets homes noticed.
        </p>
      </div>

      <form
        action="/buy"
        method="get"
        class="fade-up fade-up-delay-3 relative z-10 mt-10 rounded-3xl bg-white p-4 text-ink shadow-soft sm:mt-12 sm:p-5"
      >
        <div class="grid gap-3 lg:grid-cols-[1fr_1fr_1fr_1fr_auto]">
          <label class="block">
            <span class="mb-1.5 block text-xs font-semibold text-muted">Looking for</span>
            <select
              name="type"
              class="w-full rounded-2xl border border-line bg-snow px-3 py-3 text-sm outline-none transition focus:border-forest focus:ring-2 focus:ring-lime/40"
            >
              <option value="all">Any property</option>
              <option value="Single Family">Single Family</option>
            </select>
          </label>
          <label class="block">
            <span class="mb-1.5 block text-xs font-semibold text-muted">Price</span>
            <select
              name="maxPrice"
              class="w-full rounded-2xl border border-line bg-snow px-3 py-3 text-sm outline-none transition focus:border-forest focus:ring-2 focus:ring-lime/40"
            >
              <option value="">Any price</option>
              <option value="350000">Up to $350K</option>
              <option value="500000">Up to $500K</option>
              <option value="800000">Up to $800K</option>
              <option value="1500000">Up to $1.5M</option>
            </select>
          </label>
          <label class="block">
            <span class="mb-1.5 block text-xs font-semibold text-muted">Location</span>
            <select
              name="location"
              class="w-full rounded-2xl border border-line bg-snow px-3 py-3 text-sm outline-none transition focus:border-forest focus:ring-2 focus:ring-lime/40"
            >
              <option value="all">Houston Heights area</option>
              <option value="Acres Place">Acres Place</option>
              <option value="Heights">Houston Heights</option>
              <option value="Timbergrove">Lazybrook / Timbergrove</option>
            </select>
          </label>
          <label class="block">
            <span class="mb-1.5 block text-xs font-semibold text-muted">Bedrooms</span>
            <select
              name="beds"
              class="w-full rounded-2xl border border-line bg-snow px-3 py-3 text-sm outline-none transition focus:border-forest focus:ring-2 focus:ring-lime/40"
            >
              <option value="">Any</option>
              <option value="2">2+</option>
              <option value="3">3+</option>
              <option value="4">4+</option>
            </select>
          </label>
          <div class="flex items-end">
            <button
              type="submit"
              class="w-full rounded-full bg-ink px-6 py-3 text-sm font-semibold text-white transition hover:bg-ink-soft lg:w-auto"
            >
              Search properties
            </button>
          </div>
        </div>
      </form>
    </div>
  </section>


  <section class="border-y border-line bg-white">
    <div class="container-site grid gap-6 py-8 sm:grid-cols-3 sm:gap-0 sm:divide-x sm:divide-line">
      {
        [
          { label: "In the Heights", value: `${site.yearsInHeights}+ years` },
          { label: "Client trust", value: "5-star Google" },
          { label: "Market focus", value: "Houston Heights" },
        ].map((stat) => (
          <div class="px-2 text-center sm:px-6">
            <p class="text-2xl font-bold tracking-tight text-ink">{stat.value}</p>
            <p class="mt-1 text-sm text-muted">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-snow py-16 sm:py-20">
    <div class="container-site grid gap-5 md:grid-cols-2">
      <a
        href="/buy"
        class="group overflow-hidden rounded-3xl bg-white p-8 shadow-card transition duration-500 hover:-translate-y-1 hover:shadow-soft sm:p-10"
      >
        <span class="inline-flex rounded-full bg-lime-soft px-3 py-1 text-xs font-semibold text-forest"
          >For buyers</span
        >
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-ink">Buy a home</h2>
        <p class="mt-3 max-w-md text-muted leading-relaxed">
          Find the right home in the Heights and surrounding areas, with a team
          that stays with you through every step.
        </p>
        <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-forest transition group-hover:gap-3">
          Explore buying <span aria-hidden="true">→</span>
        </span>
      </a>
      <a
        href="/sell"
        class="group overflow-hidden rounded-3xl bg-forest p-8 text-white shadow-card transition duration-500 hover:-translate-y-1 hover:shadow-soft sm:p-10"
      >
        <span class="inline-flex rounded-full bg-lime px-3 py-1 text-xs font-semibold text-ink"
          >For sellers</span
        >
        <h2 class="mt-4 text-3xl font-bold tracking-tight">Sell a home</h2>
        <p class="mt-3 max-w-md text-white/75 leading-relaxed">
          Mary has sold hundreds of homes in the Heights and surrounding areas,
          prepared, priced, marketed, and closed with care.
        </p>
        <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-lime transition group-hover:gap-3">
          Explore selling <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="container-site">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="text-sm font-semibold text-forest">Featured homes</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
            Homes worth a closer look
          </h2>
        </div>
        <Button href="/buy" variant="secondary">See all listings</Button>
      </div>
      <p class="mt-3 max-w-2xl text-sm text-muted">
        Sample listings from Mary’s published Acres Place marketing. Live MLS
        inventory can replace these once connected.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((property) => <PropertyCard property={property} />)}
      </div>
    </div>
  </section>

  <section class="bg-snow py-16 sm:py-20">
    <div class="container-site grid items-center gap-10 lg:grid-cols-2">
      <div class="overflow-hidden rounded-3xl bg-mist shadow-card">
        <img
          src="/images/agent/mary-portrait-sq.jpg"
          alt="Mary Wassef, Houston Heights Realtor"
          class="aspect-square h-full w-full object-cover object-top"
          width="1080"
          height="1080"
          loading="lazy"
        />
      </div>
      <div>
        <p class="text-sm font-semibold text-forest">Meet Mary</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink sm:text-4xl text-balance">
          Local market knowledge. Strong marketing. Real relationships.
        </h2>
        <p class="mt-5 text-muted leading-relaxed">
          Mary Wassef is a Five-Star Houston Heights Realtor® known for luxury and
          historic homes across the Heights and near-town neighborhoods. She ranked
          in the Top 1% of Houston Realtors® for over a decade and is a Forbes Real
          Estate Council member.
        </p>
        <p class="mt-4 text-muted leading-relaxed">
          As a longtime Heights resident, she believes good real estate starts with
          knowing the community. Today she continues that work through {site.brokerage}.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/about" variant="dark">About Mary</Button>
          <Button href="/contact" variant="secondary">Get in touch</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="container-site">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="text-sm font-semibold text-forest">Neighborhoods</p>
          <h2 class="mt-2 max-w-xl text-3xl font-bold tracking-tight text-ink sm:text-4xl text-balance">
            Know the neighborhood before you buy
          </h2>
        </div>
        <Button href="/neighborhoods" variant="secondary">All neighborhoods</Button>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featuredNeighborhoods.map((n) => <NeighborhoodCard neighborhood={n} />)}
      </div>
    </div>
  </section>

  <section class="bg-snow py-16 sm:py-20">
    <div class="container-site">
      <div class="overflow-hidden rounded-3xl bg-forest text-white shadow-soft lg:grid lg:grid-cols-[0.85fr_1.15fr]">
        <div class="relative min-h-[260px]">
          <img
            src={featuredStory.image}
            alt={featuredStory.attribution}
            class="absolute inset-0 h-full w-full object-cover"
            width="800"
            height="600"
            loading="lazy"
          />
        </div>
        <div class="px-6 py-10 sm:px-10 sm:py-14">
          <p class="text-sm font-semibold text-lime">Client stories</p>
          <p class="mt-5 text-2xl font-semibold leading-snug tracking-tight text-balance sm:text-3xl">
            “{featuredStory.quote}”
          </p>
          <p class="mt-6 text-sm text-white/70">{featuredStory.attribution}</p>
          <div class="mt-8">
            <Button href="/client-stories" variant="primary">More stories</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold text-forest">Why list with Mary</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink sm:text-4xl text-balance">
          Marketing built to sell the home
        </h2>
        <p class="mt-4 text-muted leading-relaxed">
          Professional photography and videography, Google advertising, social
          promotions, and print that put every listing in front of the right buyers.
        </p>
      </div>
      <ul class="mt-10 grid gap-5 sm:grid-cols-3">
        {
          [
            {
              title: "Presentation",
              copy: "Pro photos, video, and print that show the home at its best.",
            },
            {
              title: "Digital reach",
              copy: "Google Ads, landing pages, and social campaigns that bring in qualified interest.",
            },
            {
              title: "Local network",
              copy: "Longstanding ties to Heights builders, agents, and neighborhood partners.",
            },
          ].map((item) => (
            <li class="rounded-3xl bg-snow p-6 transition duration-300 hover:-translate-y-0.5 hover:bg-white hover:shadow-card sm:p-7">
              <h3 class="text-lg font-bold text-ink">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{item.copy}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-8">
        <Button href="/sell" variant="dark">See the selling process</Button>
      </div>
    </div>
  </section>

  <section class="bg-snow pb-20 pt-8 sm:pb-24">
    <div class="container-site">
      <div class="rounded-3xl bg-white px-6 py-14 text-center shadow-card sm:px-12">
        <p class="text-sm font-semibold text-forest">Let’s connect</p>
        <h2 class="mx-auto mt-3 max-w-2xl text-3xl font-bold tracking-tight text-ink sm:text-5xl text-balance">
          Ready when you are
        </h2>
        <p class="mx-auto mt-4 max-w-lg text-muted">
          Buying, selling, or learning the Heights market? Mary would like to hear from you.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Button href="/contact" variant="primary">Contact Mary</Button>
          <Button href={site.mobileHref} variant="secondary">{site.mobile}</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
